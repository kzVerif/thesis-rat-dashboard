# Local Next development (Secure cookie behavior is intentionally unchanged).
API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_FRONTEND_WS_URL=ws://localhost:8081/ws/frontend

# Production build AND server configuration:
# API_URL=http://127.0.0.1:8080
# PUBLIC_DASHBOARD_ORIGIN=https://lab.example.com
# NEXT_PUBLIC_FRONTEND_WS_URL=wss://lab.example.com/ws/frontend
# API_URL is server-only: HTTP is allowed only to a same-host loopback origin.
# Remote API_URL must use HTTPS. Never disable Node TLS certificate validation.
# NEXT_PUBLIC_FRONTEND_WS_URL is frozen at build time: rebuild after changing it.
# Route /ws/frontend on the SAME public Dashboard hostname to the WS origin.
# Keep browser /api/* routes on Next.js so its existing proxy/auth behavior remains.
